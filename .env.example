# Unified FileEngine stack — environment.
#
# Copy to `.env` and fill in. `.env` is gitignored (holds secrets). This file
# grows as later phases add services; Phase 2 covers the data layer + core.
# No secrets are auto-generated — set them all here.

# --- Stack release version --------------------------------------------------
# Tags the built images (fileengine-*:$VERSION) and must match the base image
# built by `make base-image`. Keep in sync with the Makefile's VERSION default.
VERSION=1.4.1

# --- Domain & TLS (nginx) ---------------------------------------------------
# Apex domain the tenants are served under: <tenant>.<base> (SPA + /api,/csai,/mcp)
# and <tenant>-drive.<base> (WebDAV). Point a wildcard DNS A record *.<base> -> IP.
BASE_DOMAIN=example.com
# TLS_MODE: none (UNSECURED HTTP — testing only) | selfsigned (dev) |
#           letsencrypt-dns (automated DNS-01) | letsencrypt-manual | byo
TLS_MODE=letsencrypt-dns
# Let's Encrypt (letsencrypt-* modes):
LE_EMAIL=admin@example.com
LE_STAGING=false
# letsencrypt-dns only — DNS provider for the DNS-01 challenge (cloudflare|route53).
# Provide the provider creds: cloudflare -> mount /etc/letsencrypt/dns.ini;
# route53 -> AWS_* in the environment.
LE_DNS_PROVIDER=cloudflare
# Max upload body size proxied to the bridge (0 = unlimited).
HTTP_MAX_BODY_BYTES=0

# --- MCP server (tool-exposure policy) -------------------------------------
MCP_READ_ONLY=0
MCP_ALLOW_DELETE=0

# --- ONLYOFFICE Document Server (in-browser office editing, Phase 1.7) ------
# The `onlyoffice` service renders the embedded editor; CSAI editing is ON by
# default. Shared JWT secret between the Doc Server and CSAI (config + save
# callback are signed/verified with it) — set to a strong random value.
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt
# CSAI_ONLYOFFICE_* are DERIVED in docker-compose.yml, not set here:
#   DOCSERVER_URL = https://docs.${BASE_DOMAIN}  (browser loads the editor api.js)
#   CALLBACK_BASE = http://csai-app:8092         (Doc Server -> CSAI, internal net)
# Requirements:
#   * docs.<base> must resolve — the same *.${BASE_DOMAIN} wildcard DNS the other
#     subdomains rely on (covered by the *.<base> TLS cert).
#   * TLS_MODE must NOT be `none`: the browser loads https://docs.<base>, so an
#     http SPA origin would be blocked as mixed content. Use selfsigned/letsencrypt.
# To turn editing off without removing the service, set CSAI_ONLYOFFICE_ENABLED=false.
CSAI_ONLYOFFICE_ENABLED=true

# --- Postgres (shared by core + CSAI + discussion + folder_actions) --------
# By default the stack runs its OWN Postgres (the `postgres` service, pgvector/pg16)
# and every service reaches it at host `postgres`. To use an EXTERNAL server (RDS,
# Cloud SQL, an existing cluster) point POSTGRES_HOST/PORT at it and add the
# external-data override so the bundled one is not started:
#
#   POSTGRES_HOST=mydb.abc123.us-east-1.rds.amazonaws.com
#   docker compose -f docker-compose.yml -f docker-compose.external-data.yml up -d
#
# The external server must accept the POSTGRES_USER below with CREATEDB (db-init
# still creates the four databases) — or pre-create them and grant ownership.
# PostgreSQL 16+; CSAI and discussion need the `vector` + `pg_trgm` extensions
# available (on RDS/Cloud SQL both are; db-init issues CREATE EXTENSION).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=fileengine
POSTGRES_PASSWORD=change-me-postgres
# Database names. With the bundled server CORE_DB is created by the postgres image;
# db-init creates CSAI_DB and DISC_DB (each with the vector + pg_trgm extensions)
# and FA_DB (no extensions needed). Against an external server db-init creates all
# four, CORE_DB included.
CORE_DB=fileengine
CSAI_DB=convert_search_ai
DISC_DB=discussion
FA_DB=folder_actions

# --- Redis (core event stream + CSAI cache invalidation) -------------------
REDIS_PASSWORD=change-me-redis

# --- Object store (external S3) --------------------------------------------
# The stack bundles NO object store: the core always syncs to an external, S3-
# compatible bucket. For LOCAL testing the docker-compose.test.yml override
# provides a MinIO and sets these for you.
#
#   AWS S3          endpoint https://s3.<region>.amazonaws.com, PATH_STYLE=false
#   MinIO / Ceph    endpoint http(s)://host:9000,               PATH_STYLE=true
#   Other (R2, B2, Wasabi, GCS interop) — S3-compatible endpoint, usually
#                   PATH_STYLE=true; keep SYNC_SUPPORT=s3.
#
# Per-tenant buckets derive from S3_BUCKET. The credentials need read/write on
# those buckets (and CreateBucket if you let the core provision them).
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=fileengine
S3_ACCESS_KEY=change-me-access
S3_SECRET_KEY=change-me-secret
# false for AWS S3 (virtual-hosted addressing); true for MinIO and most others.
S3_PATH_STYLE=true
# Background sync to the object store: `aws` / `s3` for real S3, `minio` for
# MinIO, or `false` to run LOCAL-ONLY with no object store at all (files then
# live entirely on the filecache volume — back that volume up yourself).
S3_SYNC_SUPPORT=aws
# Retry interval (seconds) after a failed sync pass, and whether to sync at boot.
S3_RETRY_SECONDS=60
S3_SYNC_ON_STARTUP=true

# --- Core at-rest crypto ----------------------------------------------------
# In production keep ENCRYPT on and AT_REST_KEY STABLE — losing the key makes
# stored data unreadable. (The test override sets ENCRYPT=false to avoid key setup.)
FILEENGINE_ENCRYPT_DATA=true
FILEENGINE_COMPRESS_DATA=true
AT_REST_KEY=change-me-32-byte-key-keep-stable

# --- LDAP (389 Directory Server) — auth + tenant/role groups ----------------
# LDAP_DOMAIN is the directory suffix (derive from BASE_DOMAIN, e.g. host.com ->
# dc=host,dc=com). The bridges + MCP bind as LDAP_BIND_DN to search, then bind as
# the user to authenticate. For now the bind account is the Directory Manager
# (root) whose password is also the instance DM password — see LDAP-3 to switch
# to a least-privilege bind account.
LDAP_ENDPOINT=ldap://ldap:3389
LDAP_DOMAIN=dc=example,dc=com
LDAP_BIND_DN=cn=Directory Manager
LDAP_BIND_PASSWORD=change-me-ldap
LDAP_TENANT_BASE=ou=tenants,dc=example,dc=com
LDAP_USER_BASE=ou=users,dc=example,dc=com
# Initial administrative user (seeded into all role groups of the default tenant).
LDAP_ADMIN_EMAIL=admin@example.com
LDAP_ADMIN_PASSWORD=change-me-admin
# Default tenant name (an OU under ou=tenants). No hyphens (see WebDAV routing).
DEFAULT_TENANT=default

# --- 389 Directory web console (Cockpit) ------------------------------------
# The official cockpit-389-ds console, served at ldap-admin.<base>. Off by
# default — it grants full directory control, so only enable it behind TLS.
# When ENABLE_LDAP_ADMIN=1: the ldap container runs Cockpit (login-less, internal)
# and nginx fronts it with TLS + HTTP Basic auth using login "admin" and
# COCKPIT_ADMIN_PASSWORD. Set a strong password and consider an IP allowlist
# (see images/nginx/snippets/ldap-admin.conf).
ENABLE_LDAP_ADMIN=0
COCKPIT_ADMIN_PASSWORD=change-me-cockpit-admin

# --- http-bridge tunables ---------------------------------------------------
# Extra CORS origins (same-origin behind nginx needs none). Max upload body bytes.
HTTP_CORS_ORIGIN=
HTTP_MAX_BODY_BYTES=104857600

# --- Bearer session token (signed HS256 JWT) --------------------------------
# The bridge signs bearer tokens as HS256 JWTs carrying {tenant:[roles]}; csai and
# ldap-manager verify them LOCALLY with this same secret. REQUIRED — the bridge
# refuses to start without it. Generate a strong random value, e.g.:
#   openssl rand -hex 32
FILEENGINE_JWT_SECRET=change-me-generate-with-openssl-rand-hex-32
# JWT lifetime (seconds). Short by design: the SPA re-mints via /v1/auth/refresh,
# so LDAP role changes take effect within the refresh window and a token that
# stops being refreshed (access revoked) expires quickly.
TOKEN_TTL_SECONDS=900

# --- CSAI / AI providers (independent embedder + chat) ----------------------
# Embeddings run on the bundled CPU Ollama; chat targets an external provider.
# The two are fully independent (separate provider/model/endpoint/key).
CSAI_EMBEDDING_PROVIDER=ollama
CSAI_EMBEDDING_MODEL=nomic-embed-text
CSAI_EMBEDDING_BASE_URL=http://ollama:11434/v1
# Dimension MUST match the embedding model (nomic-embed-text = 768). Drives the
# pgvector column width when tenants are provisioned; changing it later requires
# re-provisioning + re-embedding.
CSAI_EMBEDDING_DIMENSION=768
# Chat provider: anthropic (default) | openai | ollama | openai-compatible | echo
# IMPORTANT: the default (anthropic) needs the anthropic SDK in the image AND
# ANTHROPIC_API_KEY below — otherwise chat fails with "No module named 'anthropic'".
# For an OpenAI-compatible endpoint (OpenAI / DeepInfra / vLLM / LM Studio / …) set
# provider=openai-compatible plus a base_url, model, and key. DeepInfra example:
#   CSAI_CHAT_PROVIDER=openai-compatible
#   CSAI_CHAT_BASE_URL=https://api.deepinfra.com/v1/openai
#   CSAI_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
#   CSAI_CHAT_API_KEY=<deepinfra-key>
CSAI_CHAT_PROVIDER=anthropic
CSAI_CHAT_MODEL=claude-sonnet-4-6
CSAI_CHAT_BASE_URL=
CSAI_CHAT_API_KEY=
ANTHROPIC_API_KEY=                      # required when CSAI_CHAT_PROVIDER=anthropic
# Extra CORS origins for the CSAI app (same-origin behind nginx needs none).
CSAI_CORS_ORIGINS=
# Build the CSAI image with docling (heavy ML PDF backend). 1=include (default,
# best fidelity), 0=omit (smaller/faster; chain still works via the others).
INSTALL_DOCLING=1

# --- CSAI web search (optional) ---------------------------------------------
# Lets chat answer from the live web (DuckDuckGo) alongside the user's documents.
# Requires a chat provider that supports tool-calling (anthropic / openai /
# openai-compatible). ENABLED off by default; DEFAULT controls whether a turn
# searches when the client doesn't specify (the SPA has a per-message "Web" toggle).
CSAI_WEB_SEARCH_ENABLED=false
CSAI_WEB_SEARCH_DEFAULT=false
CSAI_WEB_SEARCH_PROVIDER=duckduckgo
CSAI_WEB_SEARCH_RESULTS=5
CSAI_WEB_MAX_ITERATIONS=3

# --- CSAI indexing ----------------------------------------------------------
# Indexing reads ALL content via the core's trusted system_admin bypass so the
# vector index is complete; per-user ACLs are enforced at retrieval time. Leave
# on unless you deliberately want index-time ACL filtering.
CSAI_INDEX_BYPASS_ACL=true

# --- Discussion (document-anchored threaded comments & review) --------------
# API on /discuss/* (+ live WebSocket), a Redis event consumer, an MCP door, and
# the hourly email-digest cron. Reuses LDAP_* + POSTGRES_* + REDIS_PASSWORD +
# FILEENGINE_JWT_SECRET + the DEFAULT_TENANT/LDAP_ADMIN_* values above; its own DB
# is DISC_DB (set in the Postgres section). Comment vector index shares the bundled
# Ollama (dimension must match the model — fixes the pgvector column):
DISC_EMBEDDING_PROVIDER=ollama
DISC_EMBEDDING_MODEL=nomic-embed-text
DISC_EMBEDDING_BASE_URL=http://ollama:11434/v1
DISC_EMBEDDING_DIMENSION=768
# Email digest (sent hourly by the discussion-digest cron; per-recipient cadence
# decides who actually gets one each hour). Absolute SPA base URL for the links in
# the email; optional AI summary of the digest:
DISC_SPA_BASE_URL=
DISC_DIGEST_ENABLED=true
DISC_AI_SUMMARY_ENABLED=false
# SMTP for the digest (leave DISC_SMTP_HOST empty to log instead of send):
DISC_SMTP_HOST=
DISC_SMTP_PORT=587
DISC_SMTP_USER=
DISC_SMTP_PASSWORD=

# --- folder_actions (event-driven actions bound to a virtual folder) --------
# Admin API on /folder-actions/*, plus an event worker and a reconcile sweep.
# Reuses LDAP_* + POSTGRES_* + REDIS_PASSWORD + FILEENGINE_JWT_SECRET +
# DEFAULT_TENANT above; its own DB is FA_DB (set in the Postgres section).
#
# The action principal: every core mutation an action performs (moves, metadata)
# runs as THIS identity, authorized when the binding is created — not as the user
# whose activity triggered the event. Defaults to the LDAP_ADMIN_* account; in
# production use a dedicated LDAP account with rights only on the managed folders.
FA_PRINCIPAL_USER=
FA_PRINCIPAL_PASSWORD=
# Restrict which registered actions are active (comma-separated); empty = all.
# e.g. move_review,notify,sorter,webhook,raise_review
FA_ENABLED_ACTIONS=
# Redis consumer group for the recognized event stream.
FA_EVENTS_GROUP=folder_actions
# Reconcile sweep — recovers work missed during a Redis outage or past stream
# retention. Idempotent against the live consumer; leave enabled. The window opens
# at the last sweep's watermark (minus the overlap) and is capped by the lookback;
# MAX_FILES bounds one sweep's work per tenant and holds the watermark if hit.
FA_RECONCILE_ENABLED=true
FA_RECONCILE_INTERVAL_S=900
FA_RECONCILE_LOOKBACK_S=86400
FA_RECONCILE_OVERLAP_S=300
FA_RECONCILE_MAX_FILES=5000
FA_RECONCILE_MAX_DEPTH=32
# Fernet key encrypting webhook credentials at rest — REQUIRED before a webhook
# action can store a secret; every other action works without it. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FA_SECRET_KEY=
# SMTP for the notify action (leave FA_SMTP_HOST empty to log instead of send).
FA_SMTP_HOST=
FA_SMTP_PORT=587
FA_SMTP_USER=
FA_SMTP_PASSWORD=
FA_SMTP_FROM=
# Absolute SPA base URL for deep-links in notification emails.
FA_FRONTEND_BASE_URL=

# --- LDAP Manager (tenant user/role admin + self-service profile/password) ---
# Reuses the LDAP_* + POSTGRES_* + REDIS_PASSWORD + CSAI_DB values above (the
# email_templates table is created in CSAI_DB). Optional read replica for HA:
LDAP_ENDPOINT_REPLICA=
FILEENGINE_FAILOVER_COOLDOWN_S=30
# SMTP for invites / password reset (leave SMTP_HOST empty to disable email):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
# Frontend links carried in invite / reset emails (the SPA's set/reset pages):
INVITE_LINK_BASE=https://app.example.com/set-password
INVITE_TTL_HOURS=72
RESET_LINK_BASE=https://app.example.com/reset-password
RESET_TTL_HOURS=2
