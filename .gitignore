# Secrets / environment
.env
.env.*
!.env.example
*.secret

# TLS material (issued at deploy time; never commit)
certs/
letsencrypt/
*.pem
*.key
*.crt

# Build artifacts produced by `make` (sources live in the component repos).
# The provided AWS SDK RPMs under rpms/aws-sdk/ are inputs and stay tracked.
# The FileEngine RPMs under rpms/fileengine/ are bundled (committed) so the
# stack builds from a checkout without first rebuilding the component repos;
# refresh them with `make rpms` after a component release.
images/nginx/spa/*
!images/nginx/spa/.gitkeep
init/migrations/*.sql
!init/migrations/.gitkeep
images/csai/build-src/
images/mcp/build-src/
images/ldap-manager/build-src/
images/discussion/build-src/
images/folder-actions/build-src/
images/difference/build-src/
images/share/build-src/

# Runtime data / volumes
data/
volumes/
*.sqlite
*.db

# Logs
*.log
logs/

# IDE / editor
.idea/
.vscode/
*.swp
*~

# OS cruft
.DS_Store
Thumbs.db

# IfcOpenShell RPMs are supplied out-of-band (Makefile: "not packaged for Fedora
# and is not vendored here") and are ~73 MB each. They are staged into the csai
# and difference images at build time from IFC_RPM_DIR; committing them would
# vendor by accident what the build deliberately does not.
rpms/ifcopenshell/
