# BCF-API subservice — dev configuration (copy to .env; .env is gitignored).
# FILEENGINE_* names are shared with the core/bridges/mcp/csai/discussion.

# gRPC core (permission checks, file store)
FILEENGINE_GRPC_HOST=localhost
FILEENGINE_GRPC_PORT=50051

# Postgres (the core DB; per-tenant schemas hold the BCF projection tables)
FILEENGINE_PG_HOST=localhost
FILEENGINE_PG_PORT=5434
FILEENGINE_PG_DATABASE=fileengine
FILEENGINE_PG_USER=postgres
FILEENGINE_PG_PASSWORD=postgres

# Redis (shared broker — discussion events fan-out)
FILEENGINE_REDIS_HOST=localhost
FILEENGINE_REDIS_PORT=6379
FILEENGINE_REDIS_PASSWORD=password1
FILEENGINE_REDIS_DB=0

# Auth — OAuth 2.0 / OIDC via ldap_manager (Phase 1.7). JWT secret must match
# http_bridge's so bridge-issued tokens verify.
FILEENGINE_JWT_SECRET=
LDAP_MANAGER_URL=http://localhost:8093
# Override the discovery URLs if ldap_manager's OAuth paths differ:
# BCF_OAUTH_AUTH_URL=http://localhost:8093/oauth/authorize
# BCF_OAUTH_TOKEN_URL=http://localhost:8093/oauth/token

# This door's HTTP surface (loopback; the edge proxy fronts it in prod)
BCF_HTTP_HOST=127.0.0.1
BCF_HTTP_PORT=8098

# Optional: restrict the unauthenticated /healthz /readyz to these client IPs
# FILEENGINE_MONITORING_ALLOW_IPS=127.0.0.1
